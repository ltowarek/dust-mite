{
  "type": "object",
  "properties": {
    "thread_replies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "comment_id": { "type": "integer" },
          "body": { "type": "string" }
        },
        "required": ["comment_id", "body"]
      }
    },
    "inline_comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "body": { "type": "string" }
        },
        "required": ["path", "line", "body"]
      }
    },
    "top_level_comments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "needs_dut_run": { "type": "boolean" },
    "car_variant": { "enum": ["copper"] },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "type": { "enum": ["bug", "enhancement", "documentation"] },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["web", "camera", "telemetry", "infrastructure", "observability", "drive", "teleop"]
            }
          },
          "body": { "type": "string" }
        },
        "required": ["title", "type", "components", "body"]
      }
    },
    "already_covered": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "problem": { "type": "string" },
          "covered_by": { "type": "integer" }
        },
        "required": ["problem", "covered_by"]
      }
    }
  },
  "required": ["thread_replies", "inline_comments", "top_level_comments", "needs_dut_run"]
}
